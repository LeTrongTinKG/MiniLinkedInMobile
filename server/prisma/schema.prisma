// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  recruiter
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum JobLevel {
  intern
  fresher
  junior
}

enum JobStatus {
  open
  closed
}

enum ApplicationStatus {
  submitted
  viewed
  shortlisted
  accepted
  rejected
  withdrawn
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  githubId     String?  @unique
  role         Role     @default(student)
  fullName     String
  avatarUrl    String?

  // Rate Limiting
  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Quan hệ 1-1 Profiles
  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?

  // Quan hệ 1-N dành cho Sinh viên
  workExperiences WorkExperience[]
  educations      Education[]
  skills          UserSkill[]
  cvs             Cv[]
  applications    Application[]

  // Quan hệ 1-N dành cho Nhà tuyển dụng
  postedJobs Job[]

  refreshTokens RefreshToken[]

  // Interactions (cảm xúc + bình luận)
  reactions Reaction[]
  comments  Comment[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  headline       String?
  about          String?
  location       String?
  school         String?
  major          String?
  graduationYear Int?
  githubUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model RecruiterProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String
  companyLogoUrl String?
  position       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime? // Null = Hiện tại vẫn đang làm việc tại đây
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_experiences")
}

model Education {
  id        String   @id @default(uuid())
  userId    String
  school    String
  degree    String?
  major     String?
  startYear Int?
  endYear   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
  @@map("user_skills")
}

model Cv {
  id              String   @id @default(uuid())
  userId          String
  fileUrl         String
  fileName        String
  extractedSkills Json?    // Lưu kết quả JSON kỹ năng phân tích từ AI service
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("cvs")
}

model Job {
  id             String    @id @default(uuid())
  recruiterId    String
  title          String
  companyName    String
  companyLogoUrl String?
  location       String
  workMode       WorkMode
  level          JobLevel
  salaryMin      Int?
  salaryMax      Int?
  description    String
  requiredSkills String[]  // PostgreSQL text[]
  niceToHave     String[]  // PostgreSQL text[]
  status         JobStatus @default(open)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recruiter    User          @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications Application[]
  reactions    Reaction[]
  comments     Comment[]

  @@index([recruiterId])
  @@map("jobs")
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  studentId     String
  cvId          String
  matchScore    Float?
  matchedSkills String[]
  missingSkills String[]
  status        ApplicationStatus @default(submitted)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cv      Cv   @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId]) // Một sinh viên chỉ ứng tuyển 1 lần vào mỗi Job
  @@index([studentId])
  @@index([jobId])
  @@map("applications")
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

// Interactions: 1 User — N Reaction, 1 Job — N Reaction (mỗi user tối đa 1 cảm xúc / job)
model Reaction {
  id        String       @id @default(uuid())
  userId    String
  jobId     String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("reactions")
}

// 1 User — N Comment, 1 Job — N Comment
model Comment {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([userId])
  @@map("comments")
}
