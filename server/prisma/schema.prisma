// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  recruiter
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum JobLevel {
  intern
  fresher
  junior
  mid
  senior
  lead
}

enum JobStatus {
  open
  closed
}

// Nguồn của job: tự đăng (internal) hoặc kéo từ API ngoài
enum JobSource {
  internal
  jsearch
  serpapi
  remotive
}

enum ApplicationStatus {
  submitted
  viewed
  shortlisted
  accepted
  rejected
  withdrawn
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  githubId     String?  @unique
  role         Role     @default(student)
  fullName     String
  avatarUrl    String?

  // Rate Limiting
  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?
  tokenVersion     Int       @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Quan hệ 1-1 Profiles
  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?

  // Quan hệ 1-N dành cho Sinh viên
  workExperiences WorkExperience[]
  educations      Education[]
  skills          UserSkill[]
  skillSuggestions SkillSuggestion[]
  skillScans      SkillScan[]
  coachUsage      CoachUsage[]
  cvs             Cv[]
  applications    Application[]

  // Quan hệ 1-N dành cho Nhà tuyển dụng
  postedJobs Job[]

  refreshTokens RefreshToken[]

  // Interactions (cảm xúc + bình luận)
  reactions Reaction[]
  comments  Comment[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  headline       String?
  about          String?
  location       String?
  school         String?
  major          String?
  graduationYear Int?
  githubUrl      String?
  coachConsentAt DateTime? // null = chưa đồng ý cho chatbot đọc dữ liệu (ADR-0008)
  targetRole     String?   // id lộ trình, ví dụ "flutter-mobile"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// Số câu đã hỏi chatbot trong một ngày theo giờ Việt Nam (ADR-0008). Không lưu nội dung câu hỏi.
model CoachUsage {
  userId String
  day    String // "YYYY-MM-DD"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("coach_usage")
}

model RecruiterProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String
  companyLogoUrl String?
  position       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime? // Null = Hiện tại vẫn đang làm việc tại đây
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_experiences")
}

model Education {
  id        String   @id @default(uuid())
  userId    String
  school    String
  degree    String?
  major     String?
  startYear Int?
  endYear   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillName String
  source    String   @default("self") // "self" | "github" (ADR-0005)
  evidence  Json?    // [{ repo, url, signals, commits? }] khi skill đến từ đề xuất đã duyệt
  confidence String  @default("self_claimed") // "self_claimed" | "evidenced" (ADR-0007)
  confidenceReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
  @@map("user_skills")
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

// Skill trích từ GitHub bằng quy tắc, chờ người dùng duyệt (ADR-0005)
model SkillSuggestion {
  id        String           @id @default(uuid())
  userId    String
  skillName String
  evidence  Json             // [{ repo, url, signals }], không bao giờ rỗng
  status    SuggestionStatus @default(pending)
  decidedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId, status])
  @@map("skill_suggestions")
}

// Mỗi lần bấm "Quét GitHub". Chỉ status succeeded tính vào hạn mức tháng (ADR-0007).
model SkillScan {
  id         String    @id @default(uuid())
  userId     String
  status     String    // "running" | "succeeded" | "failed"
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("skill_scans")
}

model Cv {
  id              String   @id @default(uuid())
  userId          String
  fileUrl         String
  fileName        String
  extractedSkills Json?    // Lưu kết quả JSON kỹ năng phân tích từ AI service
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("cvs")
}

model Job {
  id             String    @id @default(uuid())
  recruiterId    String?   // null = job kéo từ nguồn ngoài
  title          String
  companyName    String
  companyLogoUrl String?
  location       String
  workMode       WorkMode
  level          JobLevel
  salaryMin      Int?
  salaryMax      Int?
  description    String
  requiredSkills String[]  // PostgreSQL text[]
  niceToHave     String[]  // PostgreSQL text[]
  status         JobStatus @default(open)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Job Sync: thông tin nguồn ngoài
  source         JobSource @default(internal)
  externalId     String?
  applyUrl       String?
  salaryCurrency String?   // VND | USD
  dedupeKey      String?
  lastSeenAt     DateTime?

  recruiter    User?         @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications Application[]
  reactions    Reaction[]
  comments     Comment[]

  @@unique([source, externalId])
  @@index([recruiterId])
  @@index([dedupeKey])
  @@map("jobs")
}

// Nhật ký mỗi lượt kéo job
model JobSyncRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  dryRun     Boolean   @default(false)
  stats      Json?     // request/nguồn, số job, lý do loại, hiệu suất từ khóa

  @@map("job_sync_runs")
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  studentId     String
  cvId          String
  matchScore    Float?
  matchedSkills String[]
  missingSkills String[]
  status        ApplicationStatus @default(submitted)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cv      Cv   @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId]) // Một sinh viên chỉ ứng tuyển 1 lần vào mỗi Job
  @@index([studentId])
  @@index([jobId])
  @@map("applications")
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

// Interactions: 1 User — N Reaction, 1 Job — N Reaction (mỗi user tối đa 1 cảm xúc / job)
model Reaction {
  id        String       @id @default(uuid())
  userId    String
  jobId     String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("reactions")
}

// 1 User — N Comment, 1 Job — N Comment
model Comment {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([userId])
  @@map("comments")
}

enum NewsCategory {
  ai
  tech
  career
}

model NewsArticle {
  id          String       @id @default(uuid())
  title       String
  summary     String?
  sourceUrl   String       @unique
  sourceName  String
  imageUrl    String?
  category    NewsCategory @default(tech)
  language    String       @default("en")
  publishedAt DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([category])
  @@index([language])
  @@map("news_articles")
}
