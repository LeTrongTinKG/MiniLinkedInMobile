# Database Supabase IPv4 Pooler (Khuyến nghị dùng để tránh lỗi IPv6 trên mạng nội địa / Windows)
# Lưu ý quan trọng: Nếu mật khẩu có ký tự '@', cần URL-encode thành '%40' (vd: doanLTDD@123 -> doanLTDD%40123)
DATABASE_URL="postgresql://postgres.puxpncrdigjbancnbrzz:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30"

# Server Port
PORT=5000

# JWT Configuration (use a unique random secret of at least 32 characters)
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_DAYS=7

# Google OAuth Client ID
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Supabase Storage Configuration
SUPABASE_URL=https://puxpncrdigjbancnbrzz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=
# Bucket Supabase Storage cho ảnh mạng xã hội (module social). Mặc định: social-media
SOCIAL_STORAGE_BUCKET=cvs

# AI Service (FastAPI)
# AI_MODE: mock (mặc định, dùng dữ liệu giả) | real (gọi AI service thật)
AI_MODE=mock
AI_SERVICE_URL=http://localhost:8000
# Tự rơi về mock nếu AI service lỗi hoặc timeout (hữu ích khi demo)
AI_FALLBACK_TO_MOCK=true

# Job Sync (kéo job từ JSearch / SerpApi / Remotive) - chỉ điền giá trị trong .env thật, không commit
RAPIDAPI_KEY=
RAPIDAPI_HOST=
SERPAPI_KEY=
