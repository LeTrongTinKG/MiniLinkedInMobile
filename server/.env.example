# Database Supabase IPv4 Pooler (Khuyến nghị dùng để tránh lỗi IPv6 trên mạng nội địa / Windows)
# Lưu ý quan trọng: Nếu mật khẩu có ký tự '@', cần URL-encode thành '%40' (vd: doanLTDD@123 -> doanLTDD%40123)
DATABASE_URL="postgresql://postgres.puxpncrdigjbancnbrzz:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30"

# Server Port
PORT=5000

# JWT Configuration (use a unique random secret of at least 32 characters)
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_DAYS=7

# Google OAuth Client ID
GOOGLE_CLIENT_ID="your_google_client_id_here"

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# Token GitHub chỉ đọc, để quét repo và đếm commit. Để trống thì mỗi giờ chỉ được khoảng 60 lần gọi.
GITHUB_READ_TOKEN=

# Supabase Storage Configuration
SUPABASE_URL=https://puxpncrdigjbancnbrzz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=
# Bucket Supabase Storage cho ảnh mạng xã hội (module social). Mặc định: social-media
SOCIAL_STORAGE_BUCKET=cvs

# AI Service (FastAPI)
# AI_MODE: mock (mặc định, dùng dữ liệu giả) | real (gọi AI service thật)
# ── Production (Render/Railway): đổi sang real khi deploy AI service Python cùng hệ thống
AI_MODE=mock
AI_SERVICE_URL=http://localhost:8000
# Tự rơi về mock nếu AI service lỗi hoặc timeout (hữu ích khi demo)
AI_FALLBACK_TO_MOCK=true

# Chatbot kỹ năng và lộ trình (ADR-0008). rules = chỉ quy tắc; ollama = model viết lại, lỗi thì dùng quy tắc.
# ── Production (Render/Railway): GIỮ rules để tiết kiệm tài nguyên, phản hồi < 1 giây, không cần Ollama.
# ── Local dev: đổi sang ollama nếu đã cài Ollama và muốn model viết lại câu trả lời.
COACH_MODE=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Thời gian giữ model trong RAM sau câu hỏi cuối. Production: 5m; local: 30m (mặc định tự chọn theo NODE_ENV)
# OLLAMA_KEEP_ALIVE=5m

# Job Sync (kéo job từ JSearch / SerpApi / Remotive) - chỉ điền giá trị trong .env thật, không commit
RAPIDAPI_KEY=
RAPIDAPI_HOST=
SERPAPI_KEY=
