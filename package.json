{
  "name": "atom-mobile",
  "version": "1.0.0",
  "description": "Atom Mobile Monorepo",
  "scripts": {
    "start:server": "cd server && npm run dev",
    "start:ai": "cd ai && python -m uvicorn main:app --reload --port 8000",
    "start:app": "node scripts/watch-flutter.js",
    "test:e2e": "playwright test",
    "tunnel:api": "cloudflared tunnel --url http://localhost:5001",
    "tunnel:web": "cloudflared tunnel --url http://localhost:3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
